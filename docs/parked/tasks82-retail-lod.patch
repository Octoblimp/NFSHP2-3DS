+    e   = (float)((int)((v.u >> 23) & 0xffu) - 128);
+    v.u = (v.u & 0x007fffffu) | 0x3f800000u;
+    return e + (-0.34484843f * v.f + 2.02466578f) * v.f - 0.67487759f;
