+// A strip's part of its K, as eSolid::CalcAutoK (0x0010bfe8) works it out
+// before the texture's size comes into it: log2(MaterialDensity / div),
+// where div is 1 less f21 * (1 - sqrt(1 - Nz^2)), at least 0.001, and f21
+// is 0.8 * (0.6 + 0.4 * max(0, bCos(Nt))). A strip with no density gets
+// K 0 (geobake.h's GeoLod).
+static float strip_lod_d(const GeoStripEntry* e)
+{
+    float z, s, c, f21, div;
+
+    if (!(e->materialDensity > 0.0f)) {
+        return GEO_LOD_KZERO;
+    }
+    z   = (float)e->normalZ * (1.0f / 16384.0f);
+    s   = 1.0f - z * z;
+    s   = s > 0.0f ? sqrtf(s) : 0.0f;
+    c   = cosf((float)e->normalT * (6.28318531f / 65536.0f));
+    f21 = 0.8f * (0.6f + 0.4f * (c > 0.0f ? c : 0.0f));
+    div = 1.0f - f21 * (1.0f - s);
+    if (div < 0.001f) {
+        div = 0.001f;
+    }
+    return log2f(e->materialDensity / div);
+}
+
+// One triangle's area, unit normal, and S's and T's change along a unit of
+// the model's space, which lie in its plane. False for one with no area.
+typedef struct {
+    float area;
+    float n[3];
+    float gs[3];
+    float gt[3];
+} TriLod;
+
+static float dot3(const float* a, const float* b)
+{
+    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+}
+
+static bool tri_lod(const GeoRenderVertex* v, const uint16_t* t, TriLod* out)
+{
+    const float* p0 = v[t[0]].pos;
+    float        e1[3], e2[3], c[3];
+    float        nn, len, a11, a12, a22;
+    int          i, k;
+
+    for (i = 0; i < 3; i++) {
+        e1[i] = v[t[1]].pos[i] - p0[i];
+        e2[i] = v[t[2]].pos[i] - p0[i];
+    }
+    c[0] = e1[1] * e2[2] - e1[2] * e2[1];
+    c[1] = e1[2] * e2[0] - e1[0] * e2[2];
+    c[2] = e1[0] * e2[1] - e1[1] * e2[0];
+    nn   = dot3(c, c);
+    if (!(nn > 1e-12f)) {
+        return false;
+    }
+    len       = sqrtf(nn);
+    out->area = 0.5f * len;
+    for (i = 0; i < 3; i++) {
+        out->n[i] = c[i] / len;
+    }
+    // g . e1 and g . e2 are the ST's changes along the two edges, and g is
+    // a mix of the edges: solved, with |e1 x e2|^2 the system's determinant.
+    a11 = dot3(e1, e1);
+    a12 = dot3(e1, e2);
+    a22 = dot3(e2, e2);
+    for (k = 0; k < 2; k++) {
+        float  d1 = v[t[1]].st[k] - v[t[0]].st[k];
+        float  d2 = v[t[2]].st[k] - v[t[0]].st[k];
+        float  a  = (d1 * a22 - d2 * a12) / nn;
+        float  b  = (d2 * a11 - d1 * a12) / nn;
+        float* g  = k ? out->gt : out->gs;
+
+        for (i = 0; i < 3; i++) {
+            g[i] = a * e1[i] + b * e2[i];
+        }
+    }
+    return true;
+}
+
+// A cluster's GeoLod, from its `count` indices at `idx` (no more than
+// GEO_CLUSTER_INDICES) and their strips' terms at `triD`, one a triangle.
+// The plane is the triangles' normals averaged by area, each turned to
+// face as the largest does, since the strips' winding is no guide; a
+// gradient is turned to agree with the largest's too, as the level does
+// not care which way the ST runs.
+static void lod_build(const GeoRenderVertex* v, const uint16_t* idx,
+                      const float* triD, int count, GeoLod* out)
+{
+    TriLod tri[GEO_CLUSTER_TRIS];
+    bool   ok[GEO_CLUSTER_TRIS];
+    int    numTris = count / 3;
+    int    big     = -1;
+    float  nsum[3] = { 0.0f, 0.0f, 0.0f };
+    float  gsAll[3] = { 0.0f, 0.0f, 0.0f }, gtAll[3] = { 0.0f, 0.0f, 0.0f };
+    float  gsFlat[3] = { 0.0f, 0.0f, 0.0f }, gtFlat[3] = { 0.0f, 0.0f, 0.0f };
+    float  total = 0.0f, flat = 0.0f, dArea = 0.0f, dSum = 0.0f;
+    float  len;
+    int    t, i;
+
+    memset(out, 0, sizeof *out);
+    out->d = GEO_LOD_KZERO;
+    if (numTris > GEO_CLUSTER_TRIS) {
+        numTris = GEO_CLUSTER_TRIS;
+    }
+    for (t = 0; t < numTris; t++) {
+        ok[t] = tri_lod(v, idx + 3 * t, &tri[t]);
+        if (ok[t] && (big < 0 || tri[t].area > tri[big].area)) {
+            big = t;
+        }
+    }
+    if (big < 0) {
+        return;
+    }
+    for (t = 0; t < numTris; t++) {
+        float w;
+
+        if (!ok[t]) {
+            continue;
+        }
+        w = dot3(tri[t].n, tri[big].n) < 0.0f ? -tri[t].area : tri[t].area;
+        for (i = 0; i < 3; i++) {
+            nsum[i] += w * tri[t].n[i];
+        }
+    }
+    len = sqrtf(dot3(nsum, nsum));
+    for (i = 0; i < 3; i++) {
+        nsum[i] = len > 0.0f ? nsum[i] / len : tri[big].n[i];
+    }
+    for (t = 0; t < numTris; t++) {
+        const TriLod* r = &tri[t];
+        float         ws, wt;
+
+        if (!ok[t]) {
+            continue;
+        }
+        ws = dot3(r->gs, tri[big].gs) < 0.0f ? -r->area : r->area;
+        wt = dot3(r->gt, tri[big].gt) < 0.0f ? -r->area : r->area;
+        total += r->area;
+        for (i = 0; i < 3; i++) {
+            gsAll[i] += ws * r->gs[i];
+            gtAll[i] += wt * r->gt[i];
+        }
+        if (fabsf(dot3(r->n, nsum)) >= 0.9f) {
+            flat += r->area;
+            for (i = 0; i < 3; i++) {
+                gsFlat[i] += ws * r->gs[i];
+                gtFlat[i] += wt * r->gt[i];
+            }
+        }
+        if (triD[t] > GEO_LOD_KZERO) {
+            dArea += r->area;
+            dSum  += r->area * triD[t];
+        }
+    }
+    if (flat >= 0.6f * total) {
+        for (i = 0; i < 3; i++) {
+            out->n[i]  = nsum[i];
+            out->gs[i] = gsFlat[i] / flat;
+            out->gt[i] = gtFlat[i] / flat;
+        }
+    } else {
+        for (i = 0; i < 3; i++) {
+            out->gs[i] = gsAll[i] / total;
+            out->gt[i] = gtAll[i] / total;
+        }
+    }
+    if (dArea >= 0.5f * total) {
+        out->d = dSum / dArea;
+    }
+}
+
+// A batch's boxes' GeoLods: its own box's is left as none, as the draw
+// asks only for its clusters'.
+static void lod_boxes(const GeoRenderVertex* v, const uint16_t* idx,
+                      const float* triD, const GeoBatch* b, GeoLod* out)
+{
+    int n = geocull_count(b->count);
+    int j;
+
+    if (n <= 0) {
+        return;
+    }
+    memset(&out[0], 0, sizeof out[0]);
+    out[0].d = GEO_LOD_KZERO;
+    for (j = 1; j < n; j++) {
+        int first = b->first + (j - 1) * GEO_CLUSTER_INDICES;
+        int count = b->first + b->count - first;
+
+        if (count > GEO_CLUSTER_INDICES) {
+            count = GEO_CLUSTER_INDICES;
+        }
+        lod_build(v, idx + first, triD + first / 3, count, &out[j]);
+    }
+}
