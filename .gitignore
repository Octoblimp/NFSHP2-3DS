# Original PS2 game dump - not distributable, kept locally only
/PS2 Files/

# Build artifacts
3DS Files/build/
*.3dsx
*.cia
*.elf
*.smdh
*.bnr
*.icn

# Extracted/converted assets (large, regenerated by tools/)
extracted/
assets_converted/
# .SBK sound banks, 6.6 MB, rebuilt by tools/audio_pack.py from extracted/SOUND
out/

# Regenerable RE dumps that are too large to usefully diff/commit
# (regenerate with tools/mdebug_stabs_scan.py in ~1s); the curated
# docs/mdebug_structs.txt this feeds is committed as the real artifact.
docs/mdebug_raw_strings.txt

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Cross-check transcripts (tools/*_check.py --keep writes these side by side)
/py.*.txt

# tools/*_mutate.py parks the pristine source here while a run is in
# flight, so a killed run can be recovered from, and hostbuild.write_source
# does the same for every *_check.py --mutate as <name>.<pid>.mutate-backup.
# Never committed.
*.mutate-backup
