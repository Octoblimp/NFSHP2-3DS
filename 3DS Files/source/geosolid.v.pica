; Vertex shader for eSolid geometry -- see docs/formats/solid-geometry.md.
;
; One strip's vertices arrive as the decoder hands them over: position and ST
; verbatim out of the VU1 packet, the RGBA5551 colour widened to four bytes,
; and the signed-byte normal. The PS2 did its lighting on VU1 before the
; packet ever reached the GS; here the PICA200's vertex stage does it, which
; is the same place in the pipeline and the reason this is a vertex shader
; rather than anything in the fragment combiner.
;
; The light is a single directional one in view space. Normals arrive as raw
; signed bytes on a radius-127 sphere rather than unit length -- that is how
; the format quantises them.
;
; Everything that is the same for a whole model is worked out once for it on
; the CPU (georender.c's set_model, geosolidunif.c), so that each vertex
; costs 17 instructions where it cost 31 (TASKS 46: the GPU's time follows
; the vertices drawn, 2026-10-10's device log). The model-view and the
; projection are one matrix; the fog's row and the light's direction are
; carried into the model's own space, the light with the normal's 1/127; and
; the colour's 1/255 is in the light's colour and the ambient. A lit view of
; a model gives the same colour to the last bit of float that it did when
; the light was turned into view space here, give or take the rounding of a
; product taken in a different order. tools/geosolid_check.py runs this
; shader and the one it replaced on the same vertices and compares them.

; Uniforms the caller sets. mvp and fogModel are geolit.v.pica's too, so the
; two passes over one strip give it the same depth to the bit: its
; environment pass meets the solid's depth with GEQUAL.
.fvec mvp[4]
.fvec fogModel

; The light, in the model's space and over 127, and its colour and the
; ambient over 255; the ambient's w is 1/255, the colour's 0, so the alpha
; comes out as the vertex's over 255.
.fvec lightModel, lightClr, ambientClr

; ST scale for the texture bound to the current draw. The PICA200 takes
; power-of-two textures only and texpack_upload() pads to one, putting the
; image in the top-left corner, so a 512x320 skin lives in a 512x512
; allocation and its ST of 1.0 has to land at 320/512. The scale is per
; texture, not per vertex, so it is a uniform the draw sets once per batch
; rather than nine more bytes baked into every vertex -- and baking it in
; would be wrong anyway, because the same mesh can be bound to a texture of
; a different size.
.fvec uvScale

.constf consts(0.0, 1.0, -1.0, 0.5)
.alias  zeros consts.xxxx
.alias  ones  consts.yyyy

; The fog's t, in the middle of its rows, which are all alike, and the z and
; w that nothing reads.
.constf fogTail(0.0, 0.5, 0.0, 0.0)

.in inpos  v0
.in intex  v1
.in inclr  v2
.in innrm  v3

.out outpos position
.out outtex texcoord0
.out outclr color
.out outfog texcoord1

; Each output register is written whole, every component exactly once,
; even the z and w the texcoords do not use: the PICA freezes on a
; component of an enabled output written twice or never (3dbrew's
; GPU/Pitfalls). The hardware enables an output register whole, in
; GPUREG_SH_OUTMAP_MASK, so all four count. Azahar draws either way; a
; New 3DS XL stopped at the first draw through this shader, one triangle
; with no texture and no depth test (2026-10-05). citro2d's shader and
; NFSU2-3DS's, which run on the device, write all four of each.

.entry vmain
.proc vmain
    ; Position: model -> clip, in one matrix.
    mov r0.xyz, inpos
    mov r0.w,   ones

    dp4 outpos.x, mvp[0], r0
    dp4 outpos.y, mvp[1], r0
    dp4 outpos.z, mvp[2], r0
    dp4 outpos.w, mvp[3], r0

    ; The fog's s: the view-space position dotted with the fog's row is the
    ; model-space one dotted with fogModel (see georender_set_fog).
    dp4 outfog.x,   fogModel, r0
    mov outfog.yzw, fogTail

    ; ST. S needs only the pad scale; T needs the scale and then a flip.
    ;
    ; The format's T counts down from the *top* row of the image, the way the
    ; GS addressed a texture. citro2d -- and so the allocation texpack_upload
    ; builds -- puts the first row in memory at v = 1 and counts down from
    ; there; uirender.c's subtex_from_pixels does `1 - y / texH` for exactly
    ; this reason, over the same upload path, verified on hardware. So
    ; v = 1 - T * scale, and the scale comes first because the image sits at
    ; the top of the padded allocation, not the bottom.
    ;
    ; Without the flip a car still draws, with the atlas mirrored top to
    ; bottom -- the grille lands on the sill and the wheel hub in the middle
    ; of a door -- which reads as "the UVs are wrong" rather than as an axis
    ; convention, and is worth recognising on sight.
    mul r7, uvScale, intex
    mov outtex.x, r7.x
    add outtex.y, ones, -r7.y
    mov outtex.zw, zeros

    ; Lambert, clamped at zero: the raw normal dotted with the light carried
    ; into its space, which is the view-space normal dotted with the view's
    ; light. lightModel points *towards* the light.
    ;
    ; The uniform goes in src1 throughout: the PICA200 allows at most one
    ; uniform read per instruction and only in the first source slot.
    dp3 r3, lightModel, innrm
    max r3, zeros, r3

    ; colour = vertex colour * (ambient + N.L * light), all over 255 already;
    ; the alpha is the vertex's by the ambient's w.
    mul r5, lightClr,   r3
    add r4, ambientClr, r5
    mul outclr, r4, inclr
    end
.end
