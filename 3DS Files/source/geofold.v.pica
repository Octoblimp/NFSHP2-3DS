; Vertex shader for the sphere map's fold: eCreateEnvMapPrims' strips
; (0x00118810), which CreateEnvMap and CreateBackEnvMap send with the
; sample table's s and t as the point on target 14 and its u and v as the
; texel of a view's target. Here the point comes in clip space already and
; the texel is the cube's, read by the direction the table gives in the
; cube's mirrored space (see eenvmap.h).
;
; The colour is the strips' RGBAQ, (96, 96, 96, 64), over 128 as the GS's
; modulate counts it: the view's texel at 0.75, and an alpha of a half,
; which ALPHA_1 0x44 blends with.

.constf consts(0.0, 1.0, -0.5, 0.0)
.constf rgbaq(0.75, 0.75, 0.75, 0.5)

.in inpos v0
.in indir v1

.out outpos position
.out outtex texcoord0.st
.out -      texcoord0w outtex.p
.out outclr color

.entry vmain
.proc vmain
    mov r0.xy, inpos.xy
    mov r0.z,  consts.z
    mov r0.w,  consts.y
    mov outpos, r0

    ; And outtex's w, which nothing reads: the PICA freezes on a component
    ; of an output register left unwritten (see geosolid.v.pica).
    mov outtex.xyz, indir.xyz
    mov outtex.w,   consts.x
    mov outclr, rgbaq
    end
.end
